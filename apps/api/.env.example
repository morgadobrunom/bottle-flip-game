# Local API environment (copy to `.env` in this folder)
#
# Pair with `pnpm dev:db` which starts PGlite on PGPORT (default 5432).
# Data lives in apps/api/.pglite and survives restarts.

APP_ENV=local
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
PGPORT=5432
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
CAMPAIGN_ID=launch
SMS_PROVIDER=console
CREDIT_PROVIDER=stub
RUN_TTL_MINUTES=40

# Required in staging/production; these defaults are rejected there.
# JWT_SECRET=
# OTP_PEPPER=
